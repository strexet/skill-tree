diff --git a/src/Habitica.WebApp/wwwroot/js/field-focus.js b/src/Habitica.WebApp/wwwroot/js/field-focus.js
index faf2347..86a6c2a 100644
--- a/src/Habitica.WebApp/wwwroot/js/field-focus.js
+++ b/src/Habitica.WebApp/wwwroot/js/field-focus.js
@@ -1,8 +1,8 @@
 // Let validation reflow finish before revealing the control that already owns
 // focus. Never pull the viewport back after the user moves to another control.
-export async function revealFocusedElement(element) {
+export async function revealFocusedElement(element, block = 'center') {
   if (!element?.isConnected) return;
   await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
   if (!element.isConnected || element.matches(':disabled') || document.activeElement !== element) return;
-  element.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
+  element.scrollIntoView({ block, inline: 'nearest', behavior: 'instant' });
 }
