  "findings": [
    {
      "acceptance_direction": "Inline and fenced examples, quoted text and every non-owner payload remain unable to authorize merge. A prior publication record cannot acquire merge authorization from non-owner reinitialization. Explicit affirmative owner scope remains supported and explicit conflicts require clarification.",
      "backlog_id": "B-c826e629-47c1-4981-990b-7c5be25223af",
      "id": "merge-authorization",
      "impact": "The helper can accept merge authorization without an affirmative direct-owner merge instruction.",
      "observation": "Inline code containing merge=true grants merge authorization; a non-owner boolean payload also sets the merge authorization bit.",
      "priority": 120,
      "severity": "P1",
      "sources": [
        ".skill-tree/common/scripts/pr-review-state.py",
        ".skill-tree/common/references/pr-review-cycle.md",
        ".skill-tree/tests/test-pr-review-cycle.py"
      ],
      "status": "open",
      "title": "Reject merge authorization from examples and non-owner payloads"
    },
    {
      "acceptance_direction": "Unsupported or conflicting operation combinations reject before writes. Every accepted dry-run combination preserves the complete installation, profile, workflow and transaction state. An ordinary explicitly requested rollback retains owned-generation behavior.",
      "backlog_id": "B-de097121-810f-440d-b3b9-39db9bcccd92",
      "id": "rollback-dry-run",
      "impact": "An accepted dry-run request mutates the installation instead of producing a read-only plan or rejecting unsupported flags.",
      "observation": "The local manager accepts --rollback --dry-run and removes nine installed skills and the profile in a disposable project.",
      "priority": 119,
      "severity": "P1",
      "sources": [
        ".skill-tree/lib/installation.js",
        ".skill-tree/documents/install.md",
        ".skill-tree/tests/test-installation-integrity.js"
      ],
      "status": "open",
      "title": "Preserve installation state for dry-run rollback and conflicting manager flags"
    },
    {
      "acceptance_direction": "An explicit reviewed bootstrap or rebind path supports a clean clone and a controller worktree, preserves canonical queue identity and terminal history, and rejects unknown ownership or modified packages. Portable declarations remain distinct from machine-local locators. A matching same-root installation remains a verified no-op.",
      "backlog_id": "B-3fdcc7a7-a8bd-471c-9309-d2369f5a2314",
      "id": "self-install-bootstrap",
      "impact": "Repository self-hosting works in the installation checkout but the normal installer and workflow commands cannot bootstrap a fresh checkout.",
      "observation": "A clean clone rejects the tracked machine-bound receipt and cannot read the retained schema-3 queue without the original Git-local locator.",
      "priority": 110,
      "severity": "P1",
      "sources": [
        ".skill-tree/lib/installation.js",
        ".skill-tree/common/scripts/run-workspaces.py",
        ".skill-tree/common/references/installation-profile.md",
        ".skill-tree/documents/manual-target-update.md"
      ],
      "status": "open",
      "title": "Provide explicit safe bootstrap for self-installed clones and worktrees"
    },
    {
      "acceptance_direction": "One documented recipe authority feeds profile composition and installed resolution. Existing source recipe IDs resolve to the intended commands with freshness checks, and completed contracts retain required verification. Unknown recipe IDs remain blocked.",
      "backlog_id": "B-4ac59ebe-f3cd-4c47-bf66-c7b52337fa43",
      "id": "source-recipe-discovery",
      "impact": "Source task validation and immutable completed-contract revalidation lose the existing recipe IDs after installation.",
      "observation": "Four recipes in the source registry disappear behind the installed profile recipe map and fail installed workflow resolution.",
      "priority": 109,
      "severity": "P2",
      "sources": [
        ".skill-tree/config/repository.json",
        ".skill-tree/lib/composer.js",
        ".skill-tree/common/scripts/workflow-state.py",
        ".skill-tree/tests/test-completed-dependency-admission.py"
      ],
      "status": "open",
      "title": "Preserve source validation recipe identities during self-installation"
    },
    {
      "acceptance_direction": "Default and explicit snapshot scopes exclude generated representative packages and installed maintenance copies while preserving canonical authored documentation. Source and target fixtures cover ownership boundaries, material context, exclusions and live-file preservation.",
      "backlog_id": "B-6f324468-ce01-44f4-831f-09165eb083af",
      "id": "snapshot-generated-output",
      "impact": "Generated copies dominate the selected context and contradict the snapshot exclusion contract.",
      "observation": "Default snapshot selection includes 333 generated representative-package documents and 17 installed maintenance-bundle documents.",
      "priority": 105,
      "severity": "P2",
      "sources": [
