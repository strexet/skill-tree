        ".skill-tree/tests/test-skill-repository-validation.py"
      ],
      "status": "open",
      "title": "Exclude generated packages and maintenance bundles from documentation snapshots"
    },
    {
      "acceptance_direction": "A bounded approved evaluation records positive and negative skill triggers, informal English and Russian requests, intake-only intent, standalone processing waits, explicit controller continuation, resumed checkpoints and authorization examples. Results distinguish model adherence from helper fixtures and retain exact model/provider/context identities. External execution and cost require separate explicit scope.",
      "backlog_id": "B-bb532f95-5acd-4f90-a842-21e9b47ddee2",
